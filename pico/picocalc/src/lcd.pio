; Serial output to the PicoCalc's LCD: SPI mode 0, most significant bit first,
; one bit every two cycles. Data on the OUT pin, the clock on the side-set pin,
; which stays low while the state machine waits for data.

.program lcd_serial
.side_set 1

.wrap_target
    out pins, 1   side 0
    nop           side 1
.wrap
